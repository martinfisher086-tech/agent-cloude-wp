# AgentKit — Complete Environment Variables Reference
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Claude Code will help you fill these during setup.
# NEVER commit your .env file to GitHub.
# All variables marked [REQUIRED] must be set before the server will start.

# ── Anthropic API ──────────────────────────────────────────────────────────
# [REQUIRED] Get your key at: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── WhatsApp Provider ──────────────────────────────────────────────────────
# [REQUIRED] Choose one: whapi | meta | twilio
WHATSAPP_PROVIDER=whapi

# ── Whapi.cloud (required when WHATSAPP_PROVIDER=whapi) ───────────────────
# Get token at: https://whapi.cloud (free plan available)
# Used to: send messages AND validate X-WHAPI-TOKEN webhook header (rule 12)
WHAPI_TOKEN=

# ── Meta Cloud API (required when WHATSAPP_PROVIDER=meta) ─────────────────
# Configure at: https://developers.facebook.com/apps
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify

# ── Twilio (required when WHATSAPP_PROVIDER=twilio) ───────────────────────
# Configure at: https://twilio.com/console
# TWILIO_AUTH_TOKEN is also used for HMAC-SHA1 webhook signature validation (rule 12)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Server ────────────────────────────────────────────────────────────────
# Port the FastAPI server listens on
PORT=8000

# [REQUIRED] Runtime environment: development | production
# In production: JSON structured logging is enabled (rule 36)
# In production: detail=str(e) is NEVER used in error responses (rule 14)
ENVIRONMENT=development

# ── Google Sheets — appointment persistence ────────────────────────────────
# [REQUIRED for appointments] Path to the service account JSON credentials file.
# Create a service account at console.cloud.google.com → IAM → Service Accounts,
# download the JSON key, and share your Sheet with the service account email.
GOOGLE_CREDENTIALS_JSON=config/google_credentials.json

# [REQUIRED for appointments] Google Sheet ID.
# Found in the sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# The sheet must have this header row (row 1):
# ID | Fecha | Hora | Servicio | Duracion | Cliente | Telefono | Estado | Agendado_en | Tenant
GOOGLE_SHEET_ID=

# ── Admin endpoints ────────────────────────────────────────────────────────
# [REQUIRED] Secret token to protect /admin/* endpoints (rules 21, 22, 29)
# Use a strong random string: openssl rand -hex 32
ADMIN_SECRET=

# ── Database ──────────────────────────────────────────────────────────────
# Local (SQLite) — default for development. Each tenant gets its own file (rule 18).
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Production (PostgreSQL on Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Multi-tenant config ────────────────────────────────────────────────────
# Path to tenant registry YAML file (rule 17). Hot-reloadable via /admin/reload-tenants.
TENANTS_CONFIG_PATH=config/tenants.yaml

# ── Rate limiting (rule 13) ────────────────────────────────────────────────
# Max webhook requests per minute per IP address. Default: 20.
RATE_LIMIT_PER_MINUTE=20

# ── Circuit breaker (rule 32) ──────────────────────────────────────────────
# Number of consecutive Claude API errors before activating the circuit breaker
CIRCUIT_BREAKER_THRESHOLD=3
# How many seconds to keep the circuit open before retrying
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# ── Locale / Internationalization (rule 37) ────────────────────────────────
# Default locale for all tenants unless overridden in tenants.yaml
# Supported: es-AR | es-MX | es-ES | en-US | pt-BR
DEFAULT_LOCALE=es-AR

# ── Logging ────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# When ENVIRONMENT=production, logs are emitted as JSON (rule 36).
# customer_phone is truncated to last 4 digits for privacy.
